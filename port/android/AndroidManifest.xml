<?xml version="1.0" encoding="utf-8"?>
<!-- Buffy the Vampire Slayer: Chaos Bleeds, the Android app: the launcher
     (Java, the PC launcher's tabs) and the game (a native activity: all of
     it C, in libbuffy.so). port/android/build_apk.sh builds it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="io.github.kaikoclanworth1.buffy"
          android:versionCode="5"
          android:versionName="1.0.2"
          android:installLocation="auto">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <!-- the renderer is Vulkan 1.3 -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- The game folder is in shared storage (games/Buffy Chaos Bleeds), as the PC build's. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="Buffy: Chaos Bleeds"
                 android:icon="@mipmap/ic_launcher"
                 android:allowBackup="false"
                 android:extractNativeLibs="true"
                 android:requestLegacyExternalStorage="true"
                 android:appCategory="game"
                 android:isGame="true"
                 android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <profileable android:shell="true" />

        <!-- First: storage access, then the launcher. -->
        <activity android:name=".InstallActivity"
                  android:exported="true"
                  android:screenOrientation="sensorLandscape"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher: Play, Settings, Controls, Mods, Textures, Saves, Install. -->
        <activity android:name=".LauncherActivity"
                  android:exported="false"
                  android:launchMode="singleTop"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- The game, in its own process (it ends with the game). -->
        <activity android:name=".GameActivity"
                  android:exported="false"
                  android:process=":game"
                  android:launchMode="singleInstance"
                  android:screenOrientation="sensorLandscape"
                  android:resizeableActivity="true"
                  android:preferMinimalPostProcessing="true"
                  android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="buffy" />
            <!-- the entry: the glue's, plus landscape and full screen (src/android_activity.c) -->
            <meta-data android:name="android.app.func_name" android:value="buffy_activity_create" />
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
        </activity>

        <!-- the Saves tab's share sheet -->
        <provider android:name=".FilesProvider"
                  android:authorities="io.github.kaikoclanworth1.buffy.files"
                  android:exported="false"
                  android:grantUriPermissions="true" />
    </application>
</manifest>
